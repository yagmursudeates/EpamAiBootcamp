# Environment variables for User Authentication API
# Copy this file to .env and fill in all values before running

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/authdb"

# JWT (RS256) — generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Store the full PEM content as a single line with \n for newlines
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ALGORITHM="RS256"

# Email (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="noreply@example.com"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="noreply@example.com"

# Application
APP_BASE_URL="https://localhost:3000"
PORT=3000

# TLS (required — FR-014)
TLS_CERT_PATH="./localhost.pem"
TLS_KEY_PATH="./localhost-key.pem"

# Node environment
NODE_ENV="development"
